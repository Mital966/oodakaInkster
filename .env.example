# Supabase configuration for Oddaka Inksters.
# Copy this file to .env.local and fill in your project values.
#
# The public site and admin still work WITHOUT these values — they fall back
# to a fully-working "local demo mode" that uses the bundled sample data.
# Set these to connect the site to your real Supabase project.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=